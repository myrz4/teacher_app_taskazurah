{
  "name": "functions",
  "description": "Cloud Functions for Firebase (Taska Zurah Chat Notifications)",
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "lint": "echo Skipping lint step...",
    "billplz:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../tools/deploy-billing-functions.ps1",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "e2e:billing": "npx firebase-tools emulators:exec --project taskazurah --only firestore \"node e2e-billing-check.js\"",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^7.2.2"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.1.0"
  },
  "private": true
}
